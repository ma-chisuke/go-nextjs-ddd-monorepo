--- a/frontend/src/features/reservation/period.ts
+++ b/frontend/src/features/reservation/period.ts
@@ -86,6 +86,22 @@
   return `${start} to ${end}`;
 }
 
+/**
+ * How long a period from `startsAt` to `endsAt` (RFC 3339) lasts, such as
+ * "1 h 30 min", "45 min", or "2 h". It counts the time that passes between
+ * the instants, so a period across a change of the clocks lasts what it
+ * lasts, not what its times of day say.
+ */
+export function formatLength(startsAt: string, endsAt: string): string {
+  const minutes = Math.round((new Date(endsAt).getTime() - new Date(startsAt).getTime()) / 60_000);
+  const hours = Math.floor(minutes / 60);
+  const rest = minutes % 60;
+  if (hours === 0) {
+    return `${String(rest)} min`;
+  }
+  return rest === 0 ? `${String(hours)} h` : `${String(hours)} h ${String(rest)} min`;
+}
+
