+func TestRenameRoomRejections(t *testing.T) {
+	t.Parallel()
+	client := newClient(t)
+	var birch facilityhttp.Room
+	client.Do(http.MethodPost, "/rooms", newRoom("Aoba"))
+	client.Do(http.MethodPost, "/rooms", newRoom("Birch")).JSON(t, &birch)
+	target := "/rooms/" + birch.Id.String()
+
+	tests := []struct {
+		name    string
+		target  string
+		body    any
+		slug    string
+		status  int
+		pointer string
+	}{
+		{"another room has the name", target, map[string]any{"name": "Aoba"}, "room-name-taken", http.StatusConflict, ""},
+		{"the room does not exist", "/rooms/0193a6f0-7b5c-7e2a-9c3d-1f2e3d4c5b6a", map[string]any{"name": "Cedar"}, "room-not-found", http.StatusNotFound, ""},
+		{"the id is not a UUID", "/rooms/not-a-uuid", map[string]any{"name": "Cedar"}, "validation-error", http.StatusUnprocessableEntity, ""},
+		{"the JSON is broken", target, []byte(`{"name":`), "malformed-request", http.StatusBadRequest, ""},
+		{"name is empty", target, map[string]any{"name": ""}, "validation-error", http.StatusUnprocessableEntity, "/name"},
+		{"name is too long", target, map[string]any{"name": strings.Repeat("n", 101)}, "validation-error", http.StatusUnprocessableEntity, "/name"},
+		{"name is missing", target, map[string]any{}, "validation-error", http.StatusUnprocessableEntity, ""},
+		{"a property is unknown", target, map[string]any{"name": "Cedar", "capacity": 4}, "validation-error", http.StatusUnprocessableEntity, ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			p := wantProblem(t, client.Do(http.MethodPatch, tt.target, tt.body), tt.slug, tt.status)
+			if tt.pointer == "" {
+				return
+			}
+			for _, invalid := range p.Errors {
+				if invalid.Pointer == tt.pointer {
+					return
+				}
+			}
+			t.Errorf("no error points at %q: %+v", tt.pointer, p.Errors)
+		})
+	}
+
+	// A refused rename changes nothing.
+	var got facilityhttp.Room
+	client.Do(http.MethodGet, target, nil).JSON(t, &got)
+	if got != birch {
+		t.Errorf("got %+v after the refused renames, want the room as it was %+v", got, birch)
+	}
+}
