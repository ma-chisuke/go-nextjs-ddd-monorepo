+// UpdateRoomName renames the room with the id, or returns pgx.ErrNoRows. It
+// fails like the database when another room has the name.
+func (f *Fake) UpdateRoomName(_ context.Context, arg postgres.UpdateRoomNameParams) (postgres.Room, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	for _, room := range f.rooms {
+		if room.Name == arg.Name && room.ID != arg.ID {
+			return postgres.Room{}, &pgconn.PgError{Code: "23505", ConstraintName: "rooms_name_key"}
+		}
+	}
+	for i := range f.rooms {
+		if f.rooms[i].ID == arg.ID {
+			f.rooms[i].Name = arg.Name
+			return f.rooms[i], nil
+		}
+	}
+	return postgres.Room{}, pgx.ErrNoRows
+}
