+func TestRenameRoomInTheDatabase(t *testing.T) {
+	t.Parallel()
+	rooms, prefix, _ := newRooms(t)
+	ctx := t.Context()
+
+	created, err := rooms.RegisterRoom(ctx, input(prefix+"Aoab"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	renamed, err := rooms.RenameRoom(ctx, created.ID, prefix+"Aoba")
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := created
+	want.Name = prefix + "Aoba"
+	if renamed != want {
+		t.Errorf("got %+v, want the registered room with the new name %+v", renamed, want)
+	}
+	if got, err := rooms.GetRoom(ctx, created.ID); err != nil || got != want {
+		t.Errorf("got %+v and %v after the rename, want %+v", got, err, want)
+	}
+
+	// The room may keep its name, and the unique constraint refuses the name
+	// of another room, which frees the old name.
+	if _, err := rooms.RenameRoom(ctx, created.ID, prefix+"Aoba"); err != nil {
+		t.Errorf("renaming the room to its own name: %v", err)
+	}
+	other, err := rooms.RegisterRoom(ctx, input(prefix+"Aoab"))
+	if err != nil {
+		t.Fatalf("registering a room under the old name: %v", err)
+	}
+	_, err = rooms.RenameRoom(ctx, other.ID, prefix+"Aoba")
+	wantKind(t, err, app.KindRoomNameTaken)
+
+	_, err = rooms.RenameRoom(ctx, uuid.Must(uuid.NewV7()), prefix+"Cedar")
