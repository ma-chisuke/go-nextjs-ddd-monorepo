+// A room may be renamed to the name that it has.
+func TestRenameRoomToItsOwnName(t *testing.T) {
+	t.Parallel()
+	client := newClient(t)
+	var registered facilityhttp.Room
+	client.Do(http.MethodPost, "/rooms", newRoom("Aoba")).JSON(t, &registered)
+
+	res := client.Do(http.MethodPatch, "/rooms/"+registered.Id.String(), map[string]any{"name": "Aoba"})
+	if res.Status != http.StatusOK {
+		t.Fatalf("got status %d, want 200\n%s", res.Status, res.Body)
+	}
+	var got facilityhttp.Room
+	res.JSON(t, &got)
+	if got != registered {
+		t.Errorf("got %+v, want the room as it was %+v", got, registered)
+	}
+}
