+func TestRenameRoom(t *testing.T) {
+	t.Parallel()
+	client := newClient(t)
+	var registered facilityhttp.Room
+	client.Do(http.MethodPost, "/rooms", newRoom("Aoab")).JSON(t, &registered)
+
+	res := client.Do(http.MethodPatch, "/rooms/"+registered.Id.String(), map[string]any{"name": "Aoba"})
+	if res.Status != http.StatusOK {
+		t.Fatalf("got status %d, want 200\n%s", res.Status, res.Body)
+	}
+	var renamed facilityhttp.Room
+	res.JSON(t, &renamed)
+	want := registered
+	want.Name = "Aoba"
+	if renamed != want {
+		t.Errorf("got %+v, want the registered room with the new name %+v", renamed, want)
+	}
+
+	var got facilityhttp.Room
+	client.Do(http.MethodGet, "/rooms/"+registered.Id.String(), nil).JSON(t, &got)
+	if got != want {
+		t.Errorf("got %+v after the rename, want %+v", got, want)
+	}
+
+	// The old name is free for another room.
+	if res := client.Do(http.MethodPost, "/rooms", newRoom("Aoab")); res.Status != http.StatusCreated {
+		t.Errorf("registering a room under the old name: got status %d, want 201\n%s", res.Status, res.Body)
+	}
+}
