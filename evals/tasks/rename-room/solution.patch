+// RenameRoom gives the room with the given id a new name, and changes nothing
+// else about it. No other room may have the name; the room may keep the name
+// that it has. It takes no version: of two renames at the same time, the
+// last one wins.
+func (r *Rooms) RenameRoom(ctx context.Context, id uuid.UUID, name string) (Room, error) {
+	row, err := r.queries.UpdateRoomName(ctx, postgres.UpdateRoomNameParams{ID: id, Name: name})
+	if errors.Is(err, pgx.ErrNoRows) {
+		return Room{}, newError(KindRoomNotFound, fmt.Sprintf("no room has the id %s", id))
+	}
+	if postgres.IsUniqueViolation(err, "rooms_name_key") {
+		return Room{}, newError(KindRoomNameTaken, fmt.Sprintf("a room named %q exists", name))
+	}
+	if err != nil {
+		return Room{}, fmt.Errorf("rename room: %w", err)
+	}
+	return roomFrom(row), nil
+}
