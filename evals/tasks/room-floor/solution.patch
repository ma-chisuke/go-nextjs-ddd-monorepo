+// A floor is a whole number from -5 to 200, and every answer with the room
+// gives it back.
+func TestRegisterRoomOnAFloor(t *testing.T) {
+	t.Parallel()
+	for _, floor := range []int32{-5, 0, 3, 200} {
+		t.Run(fmt.Sprint(floor), func(t *testing.T) {
+			t.Parallel()
+			client := newClient(t)
+			room := newRoom("Aoba")
+			room["floor"] = floor
+			wantFloor := func(what string, got facilityhttp.Room) {
+				t.Helper()
+				if got.Floor == nil || *got.Floor != floor {
+					t.Errorf("%s: got the floor %v, want %d", what, got.Floor, floor)
+				}
+			}
+
+			res := client.Do(http.MethodPost, "/rooms", room)
+			if res.Status != http.StatusCreated {
+				t.Fatalf("got status %d, want 201\n%s", res.Status, res.Body)
+			}
+			var created facilityhttp.Room
+			res.JSON(t, &created)
+			wantFloor("the registration", created)
+
+			var got facilityhttp.Room
+			client.Do(http.MethodGet, "/rooms/"+created.Id.String(), nil).JSON(t, &got)
+			wantFloor("the room", got)
+
+			var page facilityhttp.RoomPage
+			client.Do(http.MethodGet, "/rooms", nil).JSON(t, &page)
+			if len(page.Items) != 1 {
+				t.Fatalf("the list holds %d rooms, want 1", len(page.Items))
+			}
+			wantFloor("the list", page.Items[0])
+		})
+	}
+}
