+	if err != nil {
+		t.Fatal(err)
+	}
+	withoutFloor, err := rooms.RegisterRoom(ctx, input(prefix+"Aoba"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if withFloor.Floor == nil || *withFloor.Floor != -2 || withoutFloor.Floor != nil {
+		t.Errorf("got the floors %v and %v from the registrations, want -2 and none", withFloor.Floor, withoutFloor.Floor)
+	}
+
+	for _, want := range []app.Room{withFloor, withoutFloor} {
+		got, err := rooms.GetRoom(ctx, want.ID)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if (got.Floor == nil) != (want.Floor == nil) || (got.Floor != nil && *got.Floor != *want.Floor) {
+			t.Errorf("%s: got the floor %v from the database, want %v", want.Name, got.Floor, want.Floor)
+		}
+	}
